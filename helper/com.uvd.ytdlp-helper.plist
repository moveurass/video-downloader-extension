<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  macOS LaunchAgent — runs yt-dlp helper in the background (no Terminal window).
  Install:  helper/install_autostart.command
  Uninstall: helper/uninstall_autostart.command
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.uvd.ytdlp-helper</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/python3</string>
    <string>HELPER_SERVER_PATH</string>
  </array>
  <key>WorkingDirectory</key>
  <string>PROJECT_ROOT</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardOutPath</key>
  <string>LOG_DIR/uvd-helper.log</string>
  <key>StandardErrorPath</key>
  <string>LOG_DIR/uvd-helper.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>UVD_PORT</key>
    <string>8787</string>
  </dict>
</dict>
</plist>

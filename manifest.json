{
  "manifest_version": 3,
  "name": "Universal Video Downloader",
  "version": "1.23.3",
  "description": "실제 화질 칩 · 읽기 쉬운 파일명 · 정직한 진행률",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "scripting",
    "webRequest",
    "alarms",
    "contextMenus",
    "cookies",
    "notifications",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "download-current-page": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+Shift+D"
      },
      "description": "현재 탭 영상 다운로드"
    },
    "download-audio-only": {
      "suggested_key": {
        "default": "Alt+Shift+A",
        "mac": "Alt+Shift+A"
      },
      "description": "현재 탭 오디오만 다운로드"
    },
    "download-best-quality": {
      "suggested_key": {
        "default": "Alt+Shift+B",
        "mac": "Alt+Shift+B"
      },
      "description": "현재 탭 최고 화질 다운로드"
    }
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "Video Downloader",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/early-inject.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/hls-downloader.js",
        "src/page-download.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/injected.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
